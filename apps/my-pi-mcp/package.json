{
  "name": "@koonwang03/my-pi",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "description": "Local-first MCP runtime for coding agents with bounded filesystem access, safe writes, AST search, LSP navigation, and Git tooling",
  "license": "MIT",
  "mcpName": "io.github.BoxBoxmari/my-pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoxBoxmari/my-pi.git",
    "directory": "apps/my-pi-mcp"
  },
  "bugs": {
    "url": "https://github.com/BoxBoxmari/my-pi/issues"
  },
  "homepage": "https://github.com/BoxBoxmari/my-pi#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-agent",
    "coding-agents",
    "developer-tools",
    "local-first",
    "workspace-tools",
    "ast",
    "tree-sitter",
    "language-server",
    "lsp",
    "git"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
