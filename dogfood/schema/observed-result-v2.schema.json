{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-pi.local/schema/observed-result-v2.schema.json",
  "title": "my-pi ObservedTask v2 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "taskId",
    "taskDefinition",
    "taskDefinitionCommit",
    "runId",
    "status",
    "baseCommit",
    "runStartedAt",
    "runCompletedAt",
    "arms",
    "adjudication"
  ],
  "properties": {
    "schemaVersion": { "const": "2" },
    "recordType": { "const": "observed-result-v2" },
    "taskId": { "type": "string", "pattern": "^OT-[0-9]{3,}$" },
    "taskDefinition": { "type": "string", "minLength": 1 },
    "taskDefinitionCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "runId": { "type": "string", "pattern": "^run-[0-9a-f]{16}$" },
    "status": { "enum": ["COMPLETED", "FAILED", "CONTAMINATED", "INCONCLUSIVE"] },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "runStartedAt": { "type": "string", "format": "date-time" },
    "runCompletedAt": { "type": "string", "format": "date-time" },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/armResult" }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement" }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "evaluatorRunId", "recordedAt", "outcome", "evidenceRefs"],
      "properties": {
        "independent": { "type": "boolean" },
        "evaluatorRunId": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["accepted", "rejected", "inconclusive"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "armResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armId", "runId", "sessionId", "worktreeId", "baseCommit", "sourceStateDigest", "commands", "contamination"],
      "properties": {
        "armId": { "enum": ["control", "treatment"] },
        "runId": { "type": "string", "pattern": "^run-[0-9a-f]{16}$" },
        "sessionId": { "type": "string", "minLength": 1 },
        "worktreeId": { "type": "string", "minLength": 1 },
        "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "sourceStateDigest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "argv", "status", "exitCode"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "argv": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "phase": { "enum": ["arm_setup", "downstream"] },
              "status": { "enum": ["passed", "failed", "timed_out", "not_run"] },
              "exitCode": { "type": ["integer", "null"] },
              "stdoutDigest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "stderrDigest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            }
          }
        },
        "contamination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detected", "reasons"],
          "properties": {
            "detected": { "type": "boolean" },
            "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "armId", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "armId": { "enum": ["control", "treatment"] },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
