{
  "name": "my-pi-workspace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "my-pi — host-neutral coding capability substrate exposed through Model Context Protocol (MCP)",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@11.2.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build && node scripts/bundle-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "test:unit": "node --test --experimental-strip-types \"packages/*/test/**/*.test.ts\"",
    "test:release": "node --test test/release/**/*.test.mjs",
    "test:smoke": "node scripts/pr-smoke.mjs",
    "host-config": "node apps/my-pi-mcp/dist/main.js host-config",
    "bench:smoke": "node benchmarks/traversal-benchmark.mjs --profile smoke",
    "bench:release": "node benchmarks/traversal-benchmark.mjs --profile release",
    "bench:boundaries": "node benchmarks/runtime-boundaries.mjs",
    "check:refs": "node scripts/check-project-references.mjs",
    "check:arch": "node scripts/architecture-check.mjs",
    "check:boundary": "node scripts/check-public-boundary.mjs",
    "probe:era": "node scripts/probe-era.mjs",
    "smoke": "node scripts/pr-smoke.mjs",
    "verify:gates": "node scripts/verify-gates.mjs",
    "verify:evidence": "node scripts/verify-gates.mjs --strict",
    "bind:evidence": "node scripts/bind-release-evidence.mjs",
    "verify:sbom": "node scripts/verify-sbom.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "verify:boundary": "node scripts/check-public-boundary.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify": "node scripts/check-project-references.mjs && node scripts/architecture-check.mjs && node scripts/check-public-boundary.mjs && pnpm build && pnpm test && node --test test/release/**/*.test.mjs && node scripts/verify-gates.mjs && node scripts/pr-smoke.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^26.4.0",
    "esbuild": "0.28.2",
    "pyright": "^1.1.413",
    "typescript": "^5.6.0",
    "typescript-language-server": "6.0.0",
    "yaml": "2.9.0"
  }
}
