{
  "name": "ccr",
  "version": "0.1.0",
  "private": true,
  "description": "Coding Capability Runtime (CCR) v1.1 - host-neutral coding capability substrate exposed through MCP",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "test:unit": "node --test --experimental-strip-types \"packages/*/test/**/*.test.ts\"",
    "host-config": "tsx apps/ccr-mcp/src/cli.ts host-config",
    "verify:gates": "node scripts/verify-gates.mjs",
    "check:refs": "node scripts/check-project-references.mjs",
    "check:arch": "node scripts/architecture-check.mjs",
    "probe:era": "node scripts/probe-era.mjs",
    "verify": "node scripts/check-project-references.mjs && node scripts/architecture-check.mjs && pnpm build && pnpm test && node scripts/verify-gates.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
